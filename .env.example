# Copie para .env e ajuste. Nada aqui é exposto ao frontend.
PORT=3001
NODE_ENV=development

# Obrigatório em produção. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Em desenvolvimento, se vazio, um segredo local é gerado em server/database/.jwt-secret
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Origens permitidas no CORS (separadas por vírgula)
CLIENT_ORIGIN=http://localhost:5173

# Banco SQLite local (padrão: server/database/loja.db)
# DB_PATH=server/database/loja.db

# Limite de upload de imagem (MB)
MAX_UPLOAD_MB=5

# Insere produtos demonstrativos se o catálogo estiver vazio
AUTO_SEED=true

# Administrador criado na primeira inicialização (troque a senha!)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@loja.com
ADMIN_PASSWORD=admin123
